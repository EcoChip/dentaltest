# ==============================================================================
# CLÍNICA DENTAL VOLTA & ASOCIADOS - VARIABLES DE ENTORNO
# Copie este archivo como .env.local para desarrollo local o configure en Vercel/servidor.
# ==============================================================================

# URL canónica base de producción (sin barra final)
NEXT_PUBLIC_SITE_URL=https://clinicavolta.es

# Google Analytics 4 Measurement ID (opcional en desarrollo; no se carga sin consentimiento)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Bloqueo de indexación para entornos de Staging / Pruebas / Preproducción
# Establezca en 'true' para inyectar 'noindex, nofollow' y bloquear en robots.txt
NEXT_PUBLIC_BLOCK_INDEXING=false

# Clave de API de Resend para el envío transaccional de solicitudes de cita
# Si se omite, el formulario opera en modo simulación segura (loguea en servidor sin fallar)
RESEND_API_KEY=re_123456789abcdef

# Dirección de correo facultativo que recibe las notificaciones de primera visita
CLINIC_NOTIFICATION_EMAIL=citas@clinicavolta.es
